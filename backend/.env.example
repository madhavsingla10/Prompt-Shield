# PromptShield Arena - Backend Environment Configuration Template
# Copy this file to .env and fill in your API keys

# Featherless.AI API (Primary open-weights model inference: Llama 3, Mistral, Qwen)
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Optional / Alternative fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Model Selection
DEFAULT_ATTACKER_MODEL=gemini-2.5-flash
DEFAULT_EVALUATOR_MODEL=gemini-2.5-flash
DEFAULT_COMPILER_MODEL=gemini-2.5-flash
DEFAULT_TARGET_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
